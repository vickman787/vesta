# The deployed Guardian contract address on Studionet.
# Deploy contracts/guardian_budget.py at https://studio.genlayer.com and paste
# the resulting address here. Leave empty to paste it into the UI at runtime.
#
# Studio state is temporary: if Studio resets, redeploy and update this value.
NEXT_PUBLIC_GUARDIAN_CONTRACT=

# Constructor values for reference when deploying in Studio. They are not read by
# the app — Studio prompts for them in its deploy form.
#
#   authorized_agent        a second Studio account, NOT the deploying account
#   per_transaction_limit   10000000000000000   (0.01 GEN)
#   hourly_limit            50000000000000000   (0.05 GEN)
#   settlement_verifier_url https://<host>/tx/{tx}   (validators fetch this to
#                           verify a finalized transfer; must be reachable and
#                           return the receipt's status, sender, recipient, and
#                           amount)
#
# The deploying account becomes the owner. Owner and agent must differ: the owner
# sets policy, pauses, and withdraws, while the agent may only settle payments
# that already passed adjudication and still satisfy every limit.

# Private key used by `npm run test:integration` to deploy a throwaway contract
# and drive it over RPC. A Studio account key is fine — never a funded mainnet key.
ACCOUNT_PRIVATE_KEY_1=
